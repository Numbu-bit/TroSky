# Test-environment configuration. Loaded explicitly by tests/conftest.py.
# Safe, non-secret placeholder values only — this file IS committed.
APP_ENV=test
DEBUG=true
SECRET_KEY=test-only-secret-key-not-for-prod-32ch
JWT_SECRET_KEY=test-only-jwt-secret-key-not-for-prod-32
PAYMENTS_WEBHOOK_SIGNING_SECRET=test-only-webhook-secret-not-for-prod-32
TICKET_QR_SIGNING_SECRET=test-only-ticket-secret-not-for-prod-32ch
DATABASE_URL=postgresql+asyncpg://trosky:trosky@localhost:5432/trosky_test
DATABASE_URL_SYNC=postgresql+psycopg://trosky:trosky@localhost:5432/trosky_test
REDIS_URL=redis://localhost:6379/15
CELERY_BROKER_URL=redis://localhost:6379/14
CELERY_RESULT_BACKEND=redis://localhost:6379/13
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=trosky-documents-test
S3_ACCESS_KEY=test-minio-admin
S3_SECRET_KEY=test-minio-secret
EMAIL_PROVIDER=sandbox
SMS_PROVIDER=sandbox
# Tests cover both delivery modes explicitly; never inherit the dev .env's choice.
OTP_DELIVERY_CHANNEL=sms
# Accept any email (or none) unless a test turns the Gmail rule on itself.
REGISTRATION_EMAIL_DOMAINS=
# Tests send codes inline and log in unverified unless a test turns these on.
OTP_SEND_IN_BACKGROUND=false
REQUIRE_VERIFIED_ACCOUNT=false
# Bookings go straight to payment unless a test turns driver acceptance on
# (tests/integration/test_booking_acceptance.py and the API tests do).
BOOKING_ACCEPTANCE_REQUIRED=false
PAYMENTS_ACTIVE_PROVIDER=sandbox
# Many tests register and sign in from the same address within the hour;
# the production limits themselves are covered by tests/unit/test_config.py.
RATE_LIMIT_OVERRIDES=auth:register:1000:3600,auth:login:1000:300,auth:otp_request:1000:300,auth:otp_verify:1000:300
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
LOG_LEVEL=WARNING
LOG_JSON=false
OTEL_ENABLED=false
EXPOSE_HEALTH_DETAILS=true
