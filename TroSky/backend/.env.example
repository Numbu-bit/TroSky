# =============================================================================
# TroSky Backend — Environment Configuration Template
# Copy to .env for local development. NEVER commit a real .env file.
# All values below are non-secret placeholders / safe local defaults.
# =============================================================================

# --- Application ---------------------------------------------------------
APP_ENV=development                 # development | staging | production | test
APP_NAME=TroSky Backend
APP_VERSION=0.1.0
DEBUG=true                          # must be false in production
API_PREFIX=/api/v1
TIMEZONE_DISPLAY=Africa/Accra       # presentation-only; storage is always UTC

# --- Security / JWT -------------------------------------------------------
# SECRET_KEY: general application secret (session signing, CSRF, etc). >=32 chars.
SECRET_KEY=change-me-dev-only-32-characters-minimum
# JWT signing: HS256 by default (JWT_SIGNING_ALGORITHM). For RS256, set
# JWT_PRIVATE_KEY / JWT_PUBLIC_KEY (PEM, base64-encoded single-line) instead.
JWT_SIGNING_ALGORITHM=HS256
JWT_SECRET_KEY=change-me-dev-only-jwt-secret-32-chars-min
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=trosky.africa
JWT_AUDIENCE=trosky-mobile-clients
ACCESS_TOKEN_TTL_SECONDS=900        # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=2592000   # 30 days

# --- Database (PostgreSQL + PostGIS, e.g. Supabase-hosted) ---------------
DATABASE_URL=postgresql+asyncpg://trosky:trosky@localhost:5432/trosky
DATABASE_URL_SYNC=postgresql+psycopg://trosky:trosky@localhost:5432/trosky
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_ECHO=false

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# --- Celery ------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Object storage (S3-compatible; MinIO locally) ------------------------
# MinIO locally. Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com,
# region auto, S3_USE_SSL=true (docs/deploy-render.md, "File uploads").
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=trosky-documents
S3_ACCESS_KEY=trosky-minio-admin
S3_SECRET_KEY=change-me-dev-only-minio-secret
S3_USE_SSL=false
S3_PRESIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_SIZE_BYTES=10485760      # 10 MB
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,application/pdf

# --- Firebase (push notifications) ----------------------------------------
FIREBASE_CREDENTIALS_JSON=          # inline service-account JSON, or path below
FIREBASE_CREDENTIALS_PATH=          # path to service-account.json (dev only)
FIREBASE_ENABLED=false              # false => uses local mock push provider

# --- Email provider ---------------------------------------------------
EMAIL_PROVIDER=console              # console | smtp | sandbox | ses | brevo | resend | gmail_api
EMAIL_FROM_ADDRESS=no-reply@trosky.africa
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025                # MailHog default
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=false
# Keep a logged-in connection warm (NOOP every N seconds); 0 turns it off.
EMAIL_SMTP_KEEPALIVE_SECONDS=40
# brevo / resend (HTTPS, for hosts that block SMTP): the API key, and the
# sender's name. EMAIL_FROM_ADDRESS must be verified with the service; a
# Gmail address only for testing (docs/deploy-render.md, "The sender's domain").
EMAIL_API_KEY=
EMAIL_FROM_NAME=TroSky
# gmail_api (HTTPS, sends as the Gmail account the refresh token belongs to;
# EMAIL_FROM_ADDRESS should be that address): the "Desktop app" OAuth client
# from Google Cloud, and a refresh token from scripts/gmail_refresh_token.py
# (docs/deploy-render.md, "Sending real email").
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- SMS provider -----------------------------------------------------
SMS_PROVIDER=console                # console | sandbox | hubtel | twilio
SMS_SENDER_ID=TroSky
SMS_API_KEY=
SMS_API_SECRET=
SMS_BASE_URL=

# --- Payment providers (sandbox until credentials are supplied) -----------
PAYMENTS_ACTIVE_PROVIDER=sandbox    # sandbox | mtn_momo | telecel_cash | airteltigo_money | card_gateway
PAYMENTS_DEFAULT_CURRENCY=GHS
PAYMENTS_WEBHOOK_SIGNING_SECRET=change-me-dev-only-webhook-secret
# MTN MoMo Collections: python -m scripts.momo_sandbox_setup makes sandbox
# credentials and prints these (docs/deploy-render.md, "Payments: MTN MoMo
# sandbox"). API_KEY is the API user's id, API_SECRET its key.
PAYMENTS_MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
PAYMENTS_MTN_MOMO_API_KEY=
PAYMENTS_MTN_MOMO_API_SECRET=
PAYMENTS_MTN_MOMO_SUBSCRIPTION_KEY=
PAYMENTS_MTN_MOMO_TARGET_ENVIRONMENT=sandbox  # Ghana live: mtnghana
PAYMENTS_MTN_MOMO_CURRENCY=EUR                # the sandbox's only currency; empty: GHS
PAYMENTS_MTN_MOMO_CALLBACK_URL=               # https://<host>/api/v1/payments/webhooks/mtn_momo
PAYMENTS_TELECEL_CASH_BASE_URL=
PAYMENTS_TELECEL_CASH_API_KEY=
PAYMENTS_TELECEL_CASH_API_SECRET=
PAYMENTS_AIRTELTIGO_BASE_URL=
PAYMENTS_AIRTELTIGO_API_KEY=
PAYMENTS_AIRTELTIGO_API_SECRET=
PAYMENTS_CARD_GATEWAY_BASE_URL=
PAYMENTS_CARD_GATEWAY_PUBLIC_KEY=
PAYMENTS_CARD_GATEWAY_SECRET_KEY=

# --- Maps / ETA provider ------------------------------------------------
MAPS_PROVIDER=local                 # local | google | mapbox | here
MAPS_API_KEY=

# --- CORS / Trusted hosts --------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006
TRUSTED_HOSTS=localhost,127.0.0.1
# Reverse proxies whose X-Forwarded-For is believed (IPs or CIDRs, comma-
# separated). Empty = trust none, correct when nothing sits in front of the
# app. Behind a proxy, list it here or every client shares its rate limit.
TRUSTED_PROXY_CIDRS=

# --- Logging / Observability -----------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=trosky-backend
METRICS_ENABLED=true
EXPOSE_HEALTH_DETAILS=true          # must be false in production

# --- Reservations / OTP / rate limits ------------------------------
SEAT_RESERVATION_HOLD_SECONDS=600
# Bookings wait for the driver (or an admin) to accept them before the
# passenger pays. Unanswered after the timeout, a booking moves to another
# vehicle going the same way (at most BOOKING_MAX_MOVES times, among trips
# leaving within BOOKING_MOVE_WINDOW_MINUTES of the first).
BOOKING_ACCEPTANCE_REQUIRED=true
BOOKING_ACCEPT_TIMEOUT_SECONDS=120
BOOKING_MAX_MOVES=3
BOOKING_MOVE_WINDOW_MINUTES=60
# Vehicles offered to a passenger who has got off: those leaving within this.
ONWARD_TRIPS_WINDOW_MINUTES=120
OTP_LENGTH=6
OTP_EXPIRATION_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_DELIVERY_CHANNEL=sms            # sms | email (email: codes go to the account's
                                    # email address; registration then requires one)
REGISTRATION_EMAIL_DOMAINS=gmail.com,googlemail.com  # new accounts must use one;
                                    # empty accepts any email (or none)
OTP_SEND_IN_BACKGROUND=true         # send codes after responding, not during
REQUIRE_VERIFIED_ACCOUNT=true       # verify the account before password login/booking
PASSENGER_SIGNUP_COUNTRIES=GH       # passengers register from these countries (GPS);
                                    # empty switches the location check off
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
RATE_LIMIT_DEFAULT_PER_MINUTE=60
# Per-rule overrides for app.core.ratelimit.DEFAULT_RULES, as
# rule:limit:window_seconds entries separated by commas, e.g.
#   RATE_LIMIT_OVERRIDES=auth:register:100:3600,auth:login:100:300
# Rate limits are keyed per authenticated user (falling back to client IP),
# so they never serialise unrelated users' requests. Loosen these for local
# testing, where every call shares 127.0.0.1; keep EMPTY in production so the
# stricter defaults apply -- registration sends an SMS per call, and an
# unbounded endpoint is an SMS-pumping vector.
RATE_LIMIT_OVERRIDES=

# --- Password policy -------------------------------------------------
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SYMBOL=false
PASSWORD_HASH_CONCURRENCY=2         # passwords hashed at once per process (64 MiB each)

# --- GPS -----------------------------------------------------------------
GPS_UPDATE_MIN_INTERVAL_SECONDS=5
GPS_STALE_THRESHOLD_SECONDS=30
GPS_MAX_PLAUSIBLE_SPEED_KMH=140
GPS_RAW_RETENTION_DAYS=30

# --- Trips changing status on their own (from GPS and the clock) ----------
TRIP_AUTO_STATUS_ENABLED=true        # false: only drivers and admins change it
TRIP_AUTO_WINDOW_MINUTES=30          # positions accepted this long before departure
TRIP_AT_STOP_METERS=150              # this close to a stop is at it
TRIP_LEFT_STOP_METERS=300            # this far from the first stop has left it
TRIP_AUTO_PAUSE_MINUTES=20           # still this long, away from stops: paused
TRIP_STILL_METERS=50                 # moving further than this resumes it
TRIP_ARRIVAL_MINUTES=3               # at the last stop this long: completed
TRIP_ARRIVAL_SILENCE_MINUTES=10      # or silent this long once there
TRIP_NOT_STARTED_ALERT_MINUTES=15    # not started this long after departure: alert
TRIP_NOT_STARTED_CANCEL_MINUTES=120  # ...and cancelled (0: never)

# --- Ticket / QR ----------------------------------------------------------
TICKET_QR_SIGNING_SECRET=change-me-dev-only-ticket-secret-32-chars

# --- Request limits ---------------------------------------------------
MAX_REQUEST_BODY_BYTES=5242880      # 5 MB
REQUEST_TIMEOUT_SECONDS=30
