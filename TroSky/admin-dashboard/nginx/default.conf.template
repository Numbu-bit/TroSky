# The TroSky admin dashboard: a single-page app of static files.
#
# The nginx image turns this template into /etc/nginx/conf.d/default.conf
# when the container starts, filling in ${API_ORIGIN} from the environment
# (the API's origin for the Content-Security-Policy; empty when same-origin).

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml application/javascript application/json
               application/xml application/manifest+json image/svg+xml;

    # Security headers (spec section 11). Set here only: a location with its
    # own add_header would drop them all, so locations use `expires` instead.
    #   script-src 'self'  no inline scripts (the theme script is a file)
    #   style-src          inline styles: Radix positioning, map markers, toasts
    #   img-src https:     map sprites and document images from storage
    #   connect-src        this site, the API, and CARTO's free basemaps
    #   worker-src blob:   the map draws its tiles in a worker
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ${API_ORIGIN} https://basemaps.cartocdn.com https://*.basemaps.cartocdn.com; worker-src 'self' blob:; child-src blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    # For the orchestrator's health checks.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Built files carry a content hash in their names: cache them for a year.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        access_log off;
    }

    # Source maps are built for debugging, not published.
    location ~* \.map$ {
        return 404;
    }

    # Every other path is a screen of the app: index.html, never cached, so
    # a new release is picked up on the next page load.
    location / {
        try_files $uri $uri/ /index.html;
        expires -1;
    }
}
