# Development (`npm run dev`): copy to .env.local to change anything.
# Staging and production: see .env.staging.example and .env.production.example.

# Where the dashboard sends API requests. In development the Vite dev server
# proxies /api to VITE_API_PROXY_TARGET, so the default needs no CORS set-up.
# Staging/production: the API's full base URL, e.g. https://api.trosky.africa/api/v1
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Demo mode: every request is answered by realistic fake data in the browser
# (Mock Service Worker). Off by default; never on in a production build.
VITE_DEMO_MODE=false

# Modules switched on in live mode (comma-separated). All of them have
# endpoints in the backend today. Leave a module out to hide it.
VITE_ENABLED_MODULES=dispatch,driver-performance,fleet,revenue,user-growth,complaints-insights,fraud,demand,reports,audit-log,settings,wallets,alerts,team

# Live map refresh, in seconds (5-10 per SRS FR-006).
VITE_LIVE_REFRESH_SECONDS=8
