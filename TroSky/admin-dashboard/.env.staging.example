# Staging: copy to .env.staging, then build with `vite build --mode staging`
# (or pass the same values as Docker build arguments).
# The API's full base URL; the nginx container then needs API_ORIGIN set to
# the same origin (https://api.staging.trosky.africa) for its CSP.
VITE_API_BASE_URL=https://api.staging.trosky.africa/api/v1

# Always off outside demo builds: a staging build refuses demo mode.
VITE_DEMO_MODE=false

# Modules switched on (comma-separated). Leave one out to hide it.
VITE_ENABLED_MODULES=dispatch,driver-performance,fleet,revenue,user-growth,complaints-insights,fraud,demand,reports,audit-log,settings,wallets,alerts,team

# Live map refresh, in seconds (5-10 per SRS FR-006).
VITE_LIVE_REFRESH_SECONDS=8
