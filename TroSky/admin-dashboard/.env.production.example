# Production: copy to .env.production for `npm run build`, or pass the same
# values as Docker build arguments (see the Dockerfile).
# The API's full base URL; the nginx container then needs API_ORIGIN set to
# the same origin (https://api.trosky.africa) for its CSP. When the API is
# served under /api on the dashboard's own domain, keep /api/v1 and leave
# API_ORIGIN empty.
VITE_API_BASE_URL=https://api.trosky.africa/api/v1

# Always off: a production build refuses demo mode.
VITE_DEMO_MODE=false

# Modules switched on (comma-separated). Leave one out to hide it.
VITE_ENABLED_MODULES=dispatch,driver-performance,fleet,revenue,user-growth,complaints-insights,fraud,demand,reports,audit-log,settings,wallets,alerts,team

# Live map refresh, in seconds (5-10 per SRS FR-006).
VITE_LIVE_REFRESH_SECONDS=8
