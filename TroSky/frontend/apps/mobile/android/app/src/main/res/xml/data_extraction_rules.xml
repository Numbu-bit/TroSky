<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) data extraction rules. Replaces
  full-backup-content for cloud-backup and additionally governs
  device-to-device transfer (Google's Setup Wizard migration,
  OEM-specific migration tools).

  OEM-dependent caveat: a handful of vendors have been seen honoring
  cloud-backup exclusions but migrating the same data during device
  transfer anyway, or vice versa. Shipping the same exclude set in
  both <cloud-backup> and <device-transfer> is the strongest guard
  this file can give; combined with android:allowBackup="false" in
  AndroidManifest.xml, it still cannot promise every OEM will honor
  it, only that the app has asked for every supported exclusion.

  No session, no SharedPreferences, no encrypted Hive box, and no
  flutter_secure_storage Android-side ciphertext may travel through
  a backup or a device transfer. See C3 of the 21 Nov 2026
  pre-launch audit.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
        <exclude domain="device_protected_root" path="."/>
        <exclude domain="device_protected_file" path="."/>
        <exclude domain="device_protected_database" path="."/>
        <exclude domain="device_protected_sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
        <exclude domain="device_protected_root" path="."/>
        <exclude domain="device_protected_file" path="."/>
        <exclude domain="device_protected_database" path="."/>
        <exclude domain="device_protected_sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
